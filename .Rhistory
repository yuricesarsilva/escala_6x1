# --- 1.1: cnae.xlsx (mapeia classe -> descrição da classe)
# Observação: seu cnae.xlsx veio sem cabeçalho, com 2 colunas (código, descrição)
cnae_path <- "cnae.xlsx"
cnae_map <- read_excel(cnae_path, col_names = FALSE) %>%
transmute(
classe = str_pad(as.character(...1), 4, pad = "0"),
desc_classe = as.character(...2)
) %>%
distinct()
# --- 1.2: CNAE_Estrutura_Atividade_Domiciliar_2_0.xls (mapeia divisão -> seção e descrições)
# Como a estrutura pode variar, a leitura abaixo tenta "adivinhar" colunas por padrões no nome.
estrutura_path <- "CNAE_Estrutura_Atividade_Domiciliar_2_0.xls"
estr_raw <- read_excel(estrutura_path)
nm <- tolower(names(estr_raw))
col_secao  <- names(estr_raw)[grep("se[cç][aã]o|section", nm)][1]
col_div    <- names(estr_raw)[grep("divis", nm)][1]
col_desc_s <- names(estr_raw)[grep("descr.*se[cç][aã]o|se[cç][aã]o.*descr", nm)][1]
col_desc_d <- names(estr_raw)[grep("descr.*divis|divis.*descr", nm)][1]
# Se o arquivo não tiver essas descrições, seguimos só com seção e divisão.
# Monta um mapa "divisão -> seção"
div_sec_map <- estr_raw %>%
transmute(
secao = if (!is.na(col_secao)) as.character(.data[[col_secao]]) else NA_character_,
divisao = if (!is.na(col_div)) str_pad(as.character(.data[[col_div]]), 2, pad = "0") else NA_character_,
desc_secao = if (!is.na(col_desc_s)) as.character(.data[[col_desc_s]]) else NA_character_,
desc_divisao = if (!is.na(col_desc_d)) as.character(.data[[col_desc_d]]) else NA_character_
) %>%
filter(!is.na(divisao), divisao != "NA", divisao != "") %>%
distinct() %>%
arrange(divisao)
# Ajuste aqui caso seus nomes sejam diferentes
classe_base <- base_formais %>%
mutate(classe = str_pad(as.character(CNAE), 4, pad = "0"),
divisao = substr(classe, 1, 2)) %>%
left_join(div_sec_map, by = "divisao") %>%
left_join(cnae_map, by = "classe") %>%
mutate(
desc_classe = coalesce(desc_classe, as.character(`Atividades Econômicas`)),
desc_secao = ifelse(is.na(desc_secao) | desc_secao == "", paste("Seção", secao), desc_secao),
desc_divisao = ifelse(is.na(desc_divisao) | desc_divisao == "", paste("Divisão", divisao), desc_divisao)
) %>%
# garante numéricos
mutate(
Total = as.numeric(Total),
`Afetados_40` = as.numeric(`% afetados (40h)`),
`Afetados_36` = as.numeric(`% afetados (36h)`),
`Impacto_40` = as.numeric(`Impacto 40h`),
`Impacto_36` = as.numeric(`Impacto 36h`)
) %>%
select(
secao, desc_secao,
divisao, desc_divisao,
classe, desc_classe,
Total, Afetados_40, Afetados_36, Impacto_40, Impacto_36
)
# Função de agregação (médias ponderadas pelo Total)
agregar_nivel <- function(df, nivel = c("divisao","secao")) {
nivel <- match.arg(nivel)
if (nivel == "divisao") {
df %>%
group_by(secao, desc_secao, divisao, desc_divisao) %>%
summarise(
Total = sum(Total, na.rm = TRUE),
Afetados_40 = weighted.mean(Afetados_40, w = Total, na.rm = TRUE),
Afetados_36 = weighted.mean(Afetados_36, w = Total, na.rm = TRUE),
Impacto_40  = weighted.mean(Impacto_40,  w = Total, na.rm = TRUE),
Impacto_36  = weighted.mean(Impacto_36,  w = Total, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(classe = NA_character_, desc_classe = NA_character_)
} else {
df %>%
group_by(secao, desc_secao) %>%
summarise(
Total = sum(Total, na.rm = TRUE),
Afetados_40 = weighted.mean(Afetados_40, w = Total, na.rm = TRUE),
Afetados_36 = weighted.mean(Afetados_36, w = Total, na.rm = TRUE),
Impacto_40  = weighted.mean(Impacto_40,  w = Total, na.rm = TRUE),
Impacto_36  = weighted.mean(Impacto_36,  w = Total, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(divisao = NA_character_, desc_divisao = NA_character_,
classe = NA_character_, desc_classe = NA_character_)
}
}
divisao_base <- agregar_nivel(classe_base, "divisao")
divisao_base <- agregar_nivel(classe_base, "divisao")
# Função de agregação (médias ponderadas pelo Total)
agregar_nivel <- function(df, nivel = c("divisao","secao")) {
nivel <- match.arg(nivel)
df2 <- df %>%
mutate(peso = as.numeric(Total))  # <- peso original (vetor), não será sobrescrito
if (nivel == "divisao") {
df2 %>%
group_by(secao, desc_secao, divisao, desc_divisao) %>%
summarise(
Total = sum(peso, na.rm = TRUE),
Afetados_40 = weighted.mean(Afetados_40, w = peso, na.rm = TRUE),
Afetados_36 = weighted.mean(Afetados_36, w = peso, na.rm = TRUE),
Impacto_40  = weighted.mean(Impacto_40,  w = peso, na.rm = TRUE),
Impacto_36  = weighted.mean(Impacto_36,  w = peso, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(classe = NA_character_, desc_classe = NA_character_)
} else {
df2 %>%
group_by(secao, desc_secao) %>%
summarise(
Total = sum(peso, na.rm = TRUE),
Afetados_40 = weighted.mean(Afetados_40, w = peso, na.rm = TRUE),
Afetados_36 = weighted.mean(Afetados_36, w = peso, na.rm = TRUE),
Impacto_40  = weighted.mean(Impacto_40,  w = peso, na.rm = TRUE),
Impacto_36  = weighted.mean(Impacto_36,  w = peso, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(divisao = NA_character_, desc_divisao = NA_character_,
classe = NA_character_, desc_classe = NA_character_)
}
}
divisao_base <- agregar_nivel(classe_base, "divisao")
secao_base   <- agregar_nivel(classe_base, "secao")
# Função para criar "tabela detalhada" de classes dentro de cada divisão
tabela_classes_por_divisao <- function(sec, div) {
classe_base %>%
filter(secao == sec, divisao == div) %>%
arrange(desc(Impacto_36)) %>%
select(
Classe = classe,
Atividade = desc_classe,
Total,
`Afetados (40h) %` = Afetados_40,
`Afetados (36h) %` = Afetados_36,
`Impacto (40h) %`  = Impacto_40,
`Impacto (36h) %`  = Impacto_36
)
}
# Base "nível divisão" como linhas principais, com detalhes expandíveis (classes)
divisao_para_reactable <- divisao_base %>%
mutate(
Seção = paste0(secao, " — ", desc_secao),
Divisão = paste0(divisao, " — ", desc_divisao)
) %>%
select(
Seção, Divisão,
Total,
`Afetados (40h) %` = Afetados_40,
`Afetados (36h) %` = Afetados_36,
`Impacto (40h) %`  = Impacto_40,
`Impacto (36h) %`  = Impacto_36,
secao, divisao
)
tabela_cnae_drilldown <- reactable(
divisao_para_reactable,
searchable = TRUE,
filterable = TRUE,
pagination = TRUE,
defaultPageSize = 12,
highlight = TRUE,
striped = TRUE,
columns = list(
Seção = colDef(minWidth = 260),
Divisão = colDef(minWidth = 320),
Total = colDef(format = colFormat(digits = 0, separators = TRUE)),
`Afetados (40h) %` = colDef(format = colFormat(digits = 2)),
`Afetados (36h) %` = colDef(format = colFormat(digits = 2)),
`Impacto (40h) %`  = colDef(format = colFormat(digits = 2)),
`Impacto (36h) %`  = colDef(format = colFormat(digits = 2)),
secao = colDef(show = FALSE),
divisao = colDef(show = FALSE)
),
details = function(index) {
sec <- divisao_para_reactable$secao[index]
div <- divisao_para_reactable$divisao[index]
df_det <- tabela_classes_por_divisao(sec, div)
# tabela interna (classes) quando expandir
reactable(
df_det,
searchable = FALSE, filterable = FALSE, pagination = TRUE,
defaultPageSize = 8,
compact = TRUE,
columns = list(
Classe = colDef(minWidth = 90),
Atividade = colDef(minWidth = 420),
Total = colDef(format = colFormat(digits = 0, separators = TRUE)),
`Afetados (40h) %` = colDef(format = colFormat(digits = 2)),
`Afetados (36h) %` = colDef(format = colFormat(digits = 2)),
`Impacto (40h) %`  = colDef(format = colFormat(digits = 2)),
`Impacto (36h) %`  = colDef(format = colFormat(digits = 2))
)
)
}
)
impacto_uf_join <- impacto_uf_40 %>%
as.data.frame() %>%
rename(impacto40 = 2) %>%  # ajuste se a coluna não for a 2
rename(UF = 1) %>%
left_join(
impacto_uf_36 %>% as.data.frame() %>% rename(impacto36 = 2) %>% rename(UF = 1),
by = "UF"
)
impacto_uf_long <- impacto_uf_join %>%
pivot_longer(c(impacto40, impacto36), names_to = "cenario", values_to = "impacto") %>%
mutate(
cenario = recode(cenario, "impacto40" = "Novo limite: 40h", "impacto36" = "Novo limite: 36h"),
destaque = ifelse(UF == "Roraima", "Roraima", "Demais UFs"),
UF = as.character(UF)
)
# Ordena UFs pelo cenário 36h (pode trocar)
ordem_uf <- impacto_uf_join %>% arrange(impacto36) %>% pull(UF)
impacto_uf_long$UF <- factor(impacto_uf_long$UF, levels = ordem_uf)
# Cores: cinza para demais UFs; Roraima em cor diferente (duas tonalidades por cenário)
cor_rr_40 <- "#2f5f7a"  # azul discreto
cor_rr_36 <- "#1f3e59"  # azul mais escuro
impacto_uf_long <- impacto_uf_long %>%
mutate(fill_key = case_when(
destaque == "Roraima" & cenario == "Novo limite: 40h" ~ "RR_40",
destaque == "Roraima" & cenario == "Novo limite: 36h" ~ "RR_36",
destaque == "Demais UFs" & cenario == "Novo limite: 40h" ~ "OUT_40",
TRUE ~ "OUT_36"
))
grafico_uf_unico <- ggplot(impacto_uf_long, aes(x = UF, y = impacto, fill = fill_key)) +
geom_col(position = position_dodge(width = 0.75), width = 0.7, color = "grey20", linewidth = 0.25) +
geom_text(
aes(label = sprintf("%.2f", impacto)),
position = position_dodge(width = 0.75),
hjust = -0.10,
size = 3.1,
color = "grey10"
) +
coord_flip() +
scale_fill_manual(
values = c(
"OUT_40" = "grey75",
"OUT_36" = "grey35",
"RR_40"  = cor_rr_40,
"RR_36"  = cor_rr_36
),
breaks = c("OUT_40", "OUT_36"),
labels = c("Novo limite: 40h", "Novo limite: 36h"),
name = NULL
) +
labs(
title = "Impacto médio estimado da redução da jornada por UF",
subtitle = "Aumento médio do custo por hora (%) – trabalhadores CLT (PNAD Contínua, 4º tri/2025)",
x = NULL, y = NULL
) +
theme_minimal(base_size = 12) +
theme(
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
legend.position = "bottom"
) +
expand_limits(y = max(impacto_uf_long$impacto, na.rm = TRUE) * 1.12)
View(grafico_uf_unico)
grafico_uf_unico
